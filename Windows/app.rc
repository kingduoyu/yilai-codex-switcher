#include "resource.h"

IDI_APP ICON "Assets\\YilaiCodexSwitcher.ico"
IDR_BACKGROUND RCDATA "Assets\\liquid-glass-background.png"
IDR_LOGO RCDATA "Assets\\yilai-switcher-logo.png"
IDR_UPDATE RCDATA "update.ps1"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 3,4,0,0
 PRODUCTVERSION 3,4,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Yilai Codex Switcher"
      VALUE "FileVersion", "3.4.0.0"
      VALUE "ProductName", "Yilai Codex Switcher"
      VALUE "ProductVersion", "3.4.0"
      VALUE "OriginalFilename", "YilaiCodexSwitcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
